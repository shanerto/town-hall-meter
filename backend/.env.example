# Admin panel password (change this!)
ADMIN_TOKEN=your-secret-token

# --- Database (Vercel / serverless production) ---
# Create a free database at https://turso.tech, then:
#   turso db create town-hall-meter
#   turso db show town-hall-meter --url        → TURSO_DATABASE_URL
#   turso db tokens create town-hall-meter     → TURSO_AUTH_TOKEN
#
# When these are set, @libsql/client connects over HTTP — no native
# compilation needed. When unset, it uses a local SQLite file.
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Frontend origin (comma-separated) for CORS — optional, defaults to *
# ALLOWED_ORIGINS=https://your-app.vercel.app
