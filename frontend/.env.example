# URL of the backend API server (no trailing slash).
# Only needed when the frontend and backend are on different hosts,
# e.g. frontend on Vercel and backend on Railway / Render / Fly.io.
# Leave this unset (or delete this file) when running everything locally
# or when serving both from the same Express process.
VITE_API_BASE_URL=https://your-backend.railway.app
